# Read-only scanner configuration. Never put wallet keys in this file.
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_TESTNET_RPC_URL=https://rpc.testnet.near.org
# Set after independently verifying the currently deployed Rhea contracts.
RHEA_LENDING_CONTRACT=
RHEA_ORACLE_CONTRACT=
# Signing and spending on NEAR mainnet are not implemented. The genuine
# Stage93 execution uses only a disposable NEAR Workspaces Sandbox actor.
# This file MUST NOT contain recovery phrases or wallet private keys.
EXECUTION_ENABLED=false

# Operations dashboard. Required outside loopback. Never reuse a wallet key.
ARBIVANE_DASHBOARD_TOKEN=
ARBIVANE_DASHBOARD_ORIGIN=
ARBIVANE_DASHBOARD_DATA_DIR=.arbivane-dashboard
# Genuine Stage35 proposal consumed by the existing local Workspaces runner.
# Stage187 explicit opt-in for isolated Workspaces automation, not mainnet trading.
ARBIVANE_SANDBOX_AUTOPILOT_ENABLED=false
ARBIVANE_SCAN_PAGE_ACCOUNTS=150
ARBIVANE_SCAN_EVALUATIONS=8
ARBIVANE_SCAN_INTERVAL_MS=8000
ARBIVANE_SESSION_ATTEMPTS=3
# Legacy manual historical replay only:
ARBIVANE_SANDBOX_EVIDENCE_PATH=
# Stage 2 optional read-only indicative valuation. These are documentation-listed,
# NOT independently RPC-verified in this milestone. Never enable execution.
# Mainnet lending: contract.main.burrow.near
# Mainnet current documented oracle: aggregate-oracle.near
# Historical bot oracle priceoracle.near is NOT the current default.
# Verify get_price_data compatibility, timestamp, and deployed bytecode first.

# Optional *independently approved* code hash pins for the read-only verifier.
RHEA_EXPECTED_LENDING_CODE_HASH=
RHEA_EXPECTED_ORACLE_CODE_HASH=

# Stage 4: optional, strictly READ-ONLY Pyth aggregate-oracle compatibility diagnostic.
# MUST be independently reviewed against the deployed Rhea feed mapping;
# NEVER assume a token ticker corresponds to a particular 64-char price ID.
RHEA_OPERATOR_FEED_MAPPINGS_JSON=

# Pyth contract read mode: single uses the method observed in live Rhea receipts.
RHEA_PYTH_READ_METHOD=single

# Stage 5: no new environment secrets. Probe on-chain lending metadata with
# npm run probe:rhea:metadata (read-only; does not approve any feed for trading).

# Stage 7 read-only borrower sampling (1..200; page size 1..50)
RHEA_AUDIT_MAX_ACCOUNTS=25
RHEA_AUDIT_PAGE_SIZE=10

# Stage 9 READ-ONLY borrower differential (no transaction permissions)
RHEA_STAGE9_MAX_ACCOUNTS=40
RHEA_STAGE9_PAGE_SIZE=10
RHEA_STAGE9_MAX_DETAILS=8

# Stage 11 manual, read-only account-index discovery
RHEA_DISCOVERY_FROM_INDEX=0
RHEA_DISCOVERY_MAX_ACCOUNTS=200
RHEA_DISCOVERY_PAGE_SIZE=25
RHEA_DISCOVERY_MAX_FINDINGS=20

# Stage 14.1 public NEAR RPC pacing / exponential 429 backoff
RHEA_BACKFILL_CONCURRENCY=2
RHEA_BACKFILL_BATCH_DELAY_MS=1250
RHEA_BACKFILL_MAX_RETRIES=7
RHEA_BACKFILL_RATE_LIMIT_DELAY_MS=5000

# Stage 15 read-only paper health probe (not executable Rhea eligibility)
RHEA_HEALTH_FROM_INDEX=0
RHEA_HEALTH_MAX_ACCOUNTS=200
RHEA_HEALTH_PAGE_SIZE=25
RHEA_HEALTH_MAX_FINDINGS=10
RHEA_HEALTH_MAX_DETAILS=8
RHEA_HEALTH_MAX_FEEDS=12
RHEA_HEALTH_DETAIL_BUDGET=8
RHEA_HEALTH_MAX_AGE_MS=60000
