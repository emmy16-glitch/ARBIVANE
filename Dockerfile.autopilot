# Dedicated paid, persistent NEAR Workspaces execution backend.
# Do not use this image to enable mainnet signing.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm install --no-save --ignore-scripts --no-audit --no-fund near-workspaces@5.0.0
COPY . .
RUN npm run build:dashboard
ENV NODE_ENV=production HOST=0.0.0.0 PORT=10000 EXECUTION_ENABLED=false
EXPOSE 10000
CMD ["node","dashboard/server/index.mjs"]

