{
  "name": "arbivane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --config dashboard/web/vite.config.ts",
    "dev:api": "node dashboard/server/index.mjs",
    "build:dashboard": "vite build --config dashboard/web/vite.config.ts",
    "preview:dashboard": "vite preview --config dashboard/web/vite.config.ts",
    "test:dashboard": "node --test tests/dashboard-*.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "node --experimental-strip-types src/demo/run.ts",
    "scan:readonly": "node --experimental-strip-types src/rhea/cli.ts",
    "check": "npm run typecheck && npm run build:dashboard && npm test",
    "scan:indicative": "node --experimental-strip-types src/rhea/assess-cli.ts",
    "probe:rhea": "node --experimental-strip-types src/rhea/probe-cli.ts",
    "probe:rhea:aggregate": "node --experimental-strip-types src/rhea/aggregate-probe-cli.ts",
    "probe:rhea:metadata": "node --experimental-strip-types src/rhea/market-metadata-cli.ts",
    "probe:rhea:coverage": "node --experimental-strip-types src/rhea/coverage-cli.ts",
    "probe:rhea:borrowers": "node --experimental-strip-types src/rhea/borrower-audit-cli.ts",
    "audit:rhea:source": "EXECUTION_ENABLED=false node --experimental-strip-types src/rhea/source-audit-cli.ts",
    "probe:rhea:share-parity": "node --experimental-strip-types src/rhea/deployed-share-parity-cli.ts",
    "probe:rhea:isolated-parity": "node --experimental-strip-types src/rhea/isolated-parity-cli.ts",
