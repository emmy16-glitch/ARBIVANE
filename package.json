    "probe:rhea:paper-health": "node --experimental-strip-types src/rhea/health-screen-cli.ts",
    "score:rhea:paper": "node --experimental-strip-types src/rhea/opportunity-simulation-cli.ts",
    "probe:rhea:indexed-health": "node --experimental-strip-types src/rhea/indexed-health-pipeline-cli.ts",
