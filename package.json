    "probe:rhea:active-pyth-valuation": "node --experimental-strip-types src/rhea/execution-pyth-valuation-cli.ts",
    "probe:rhea:paged-position-index": "node --experimental-strip-types src/rhea/paged-position-index-cli.ts",
    "probe:rhea:stage31-debt-queue": "node --experimental-strip-types src/rhea/active-pyth-debt-queue-cli.ts",
    "probe:rhea:stage43-blocked-retry": "node --experimental-strip-types src/rhea/stage43-blocked-observation-retry-cli.ts",
    "probe:rhea:stage44-recovered-risk": "node --experimental-strip-types src/rhea/stage44-recovered-risk-sandbox-preflight-cli.ts",
